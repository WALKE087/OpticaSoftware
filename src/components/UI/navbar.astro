---
import { Icon } from "astro-icon/components";

import { getSession } from "auth-astro/server";
import { SignOut } from "auth-astro/components";

const session = await getSession(Astro.request);
const currentView = Astro.url.searchParams.get("view");
---

<nav
  class="bg-white/80 dark:bg-[#0f172a]/90 backdrop-blur-md shadow-md sticky top-0 z-50 transition"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-between py-3"
  >
    <!-- LOGO -->
    <a
      href="/"
      class="text-2xl font-bold text-cyan-700 dark:text-cyan-400 tracking-tight"
    >
      Óptica
    </a>

    <!-- Botón de menú móvil -->
    <button
      data-collapse-toggle="navbar-user"
      type="button"
      class="md:hidden p-2 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#1e293b] rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-400"
      aria-controls="navbar-user"
      aria-expanded="false"
    >
      <span class="sr-only">Abrir menú</span>
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- Links de navegación -->
    <div class="hidden md:flex md:w-auto w-full mt-4 md:mt-0" id="navbar-user">
      <ul
        class="flex flex-col md:flex-row gap-2 md:gap-6 font-medium text-sm w-full md:items-center"
      >
        <li>
          <a
            href="/?view=vista-gafas"
            class={`px-4 py-2 rounded-lg transition ${
              currentView === "vista-gafas"
                ? "bg-cyan-100 text-cyan-800 dark:bg-cyan-700/20 dark:text-cyan-300"
                : "text-gray-800 hover:text-cyan-600 dark:text-gray-200 dark:hover:text-cyan-400"
            }`}
          >
            Productos
          </a>
        </li>
        <li>
          <a
            href="/?view=nuestras-clinicas"
            class={`px-4 py-2 rounded-lg transition ${
              currentView === "nuestras-clinicas"
                ? "bg-cyan-100 text-cyan-800 dark:bg-cyan-700/20 dark:text-cyan-300"
                : "text-gray-800 hover:text-cyan-600 dark:text-gray-200 dark:hover:text-cyan-400"
            }`}
          >
            Ópticas
          </a>
        </li>
        {
          session && (
            <li>
              <a
                href="#"
                class="px-4 py-2 text-gray-700 dark:text-gray-200 hover:text-cyan-600 dark:hover:text-cyan-400 transition"
              >
                Carrito
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <!-- Sesión / Avatar -->
    <div class="flex items-center gap-4 mt-4 md:mt-0">
      {
        session ? (
          <>
            <SignOut id="google-signin-button">
              <button class="px-4 py-2 text-sm font-semibold rounded-full bg-gradient-to-r from-cyan-500 to-blue-500 text-white shadow-md hover:shadow-lg transition duration-200">
                Cerrar Sesión
              </button>
            </SignOut>
            <div class="relative w-10 h-10 rounded-full ring-2 ring-cyan-500 hover:ring-cyan-400 transition duration-200 overflow-hidden">
              <img
                src={session?.user?.image}
                alt="Usuario"
                class="w-full h-full object-cover"
              />
            </div>
          </>
        ) : (
          <a href="/login">
            <button
              class="px-3 py-1.5 rounded-full border-2 border-cyan-500 text-cyan-500 font-medium text-sm
           bg-transparent transition-colors duration-300
           hover:bg-gradient-to-r hover:from-cyan-500 hover:to-blue-500 hover:text-white
           focus:outline-none focus:ring-2 focus:ring-cyan-300 dark:focus:ring-cyan-700"
            >
              Iniciar Sesión
            </button>
          </a>
        )
      }
    </div>
  </div>
</nav>
