<script>
  import { updateProducto } from "../logic/servicioProductos";
  import { addProducts, deleteProducto } from "../logic/servicioProductos";
  import type { Gafas } from "../models/gafas";

  let searchQuery = "";
  const inputSearch = document.getElementById(
    "inputSearchProduct"
  ) as HTMLInputElement;
  const productTableBody = document.getElementById(
    "productTable"
  ) as HTMLTableSectionElement;

  function filterProduct() {
    const search = searchQuery.toLowerCase();
    const rows = Array.from(productTableBody.children) as HTMLElement[];

    rows.forEach((row) => {
      // Ajustar los índices si la estructura de tu tabla cambia
      const nombre = row.children[1]?.textContent?.toLowerCase() || "";
      const marca = row.children[2]?.textContent?.toLowerCase() || "";
      const precio = row.children[3]?.textContent?.toLowerCase() || "";
      const stock = row.children[4]?.textContent?.toLocaleLowerCase() || "";
      const montura = row.children[5]?.textContent?.toLocaleLowerCase() || "";
      const color = row.children[6]?.textContent?.toLocaleLowerCase() || "";

      if (
        nombre.includes(search) ||
        marca.includes(search) ||
        precio.includes(search) ||
        stock.includes(search) ||
        montura.includes(search) ||
        color.includes(search)
      ) {
        row.style.display = "";
      } else {
        row.style.display = "none";
      }
    });
  }

  inputSearch.addEventListener("input", (event) => {
    searchQuery = (event.target as HTMLInputElement).value;
    filterProduct();
  });

  // Función de validación centralizada
  function validateProductForm(formData: FormData, isEdit: boolean): boolean {
    const nombre = formData.get("nombre") as string;
    const marca = formData.get("marca") as string;
    const precio = parseFloat(formData.get("precio") as string);
    const stock = parseInt(formData.get("stock") as string);
    const imagenFile = (
      document.getElementById(
        isEdit ? "imagenInputEdit" : "imagenInput"
      ) as HTMLInputElement
    ).files?.[0];
    const imagenActual = formData.get("imagenActual") as string;
    const tipomontura = formData.get("tipomontura") as string;
    const color = formData.get("color") as string;

    if (!nombre || nombre.trim() === "") {
      alert("El nombre del producto no puede estar vacío.");
      return false;
    }

    if (!marca || marca.trim() === "") {
      alert("La marca del producto no puede estar vacía.");
      return false;
    }

    if (isNaN(precio) || precio <= 0) {
      alert("El precio debe ser un número mayor que 0.");
      return false;
    }

    if (isNaN(stock) || stock < 0) {
      alert("El stock debe ser un número entero mayor o igual a 0.");
      return false;
    }

    if (!isEdit && !imagenFile) {
      alert("Por favor, selecciona una imagen para el producto.");
      return false;
    }

    if (isEdit && !imagenFile && !imagenActual) {
      alert(
        "Debe haber una imagen para el producto. Si no seleccionas una nueva, la anterior se mantendrá."
      );
      return false;
    }

    if (!tipomontura || tipomontura.trim() === "") {
      alert("El tipo de montura no puede estar vacío.");
      return false;
    }

    if (!color || color.trim() === "") {
      alert("El color del producto no puede estar vacío.");
      return false;
    }

    return true;
  }

  document
    .getElementById("formAgregarProducto")
    .addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.target as HTMLFormElement;
      const formData = new FormData(form);

      if (!validateProductForm(formData, false)) {
        // 'false' para indicar que es el formulario de agregar
        return;
      }

      const imagenInput = document.getElementById(
        "imagenInput"
      ) as HTMLInputElement;
      const imagenFile = imagenInput.files?.[0];

      let imagenBase64 = "";
      if (imagenFile) {
        imagenBase64 = await convertToBase64(imagenFile);
      }

      const productoData: Gafas = {
        id: 0, // El ID será asignado por el backend
        nombre: formData.get("nombre") as string,
        marca: formData.get("marca") as string,
        precio: parseFloat(formData.get("precio") as string),
        stock: parseInt(formData.get("stock") as string),
        imagen: imagenBase64,
        tipomontura: formData.get("tipomontura") as string,
        color: formData.get("color") as string,
      };

      try {
        const response = await addProducts(productoData);
        if (response.success) {
          alert("Producto agregado exitosamente");
          window.location.reload();
        } else {
          alert(response.error || "Error al agregar el producto.");
        }
      } catch (error) {
        console.error("Error en el formulario:", error);
        alert("Error inesperado. Intenta nuevamente.");
      }
    });

  function convertToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = () => resolve(reader.result as string);
      reader.onerror = (error) => reject(error);
    });
  }

  document
    .getElementById("imagenInput")
    ?.addEventListener("change", function (e) {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function (event) {
          const preview = document.getElementById(
            "previewImage"
          ) as HTMLImageElement;
          preview.src = event.target?.result as string;
          document.getElementById("imagePreview")?.classList.remove("hidden");
        };
        reader.readAsDataURL(file);
      } else {
        document.getElementById("imagePreview")?.classList.add("hidden");
      }
    });

  const modalAgregar = document.getElementById(
    "modalAgregarProductos"
  ) as HTMLElement;
  const btnAgregarProducto = document.getElementById(
    "agregarProducto"
  ) as HTMLButtonElement;
  const btncancelarProductos = document.getElementById(
    "cancelarModalProductos"
  ) as HTMLButtonElement;

  btnAgregarProducto.addEventListener("click", () => {
    modalAgregar.classList.remove("hidden");
  });

  btncancelarProductos.addEventListener("click", () => {
    modalAgregar.classList.add("hidden");
    (document.getElementById("formAgregarProducto") as HTMLFormElement).reset();
    document.getElementById("imagePreview")?.classList.add("hidden");
  });

  window.addEventListener("click", (event) => {
    if (event.target === modalAgregar) {
      modalAgregar.classList.add("hidden");
      (
        document.getElementById("formAgregarProducto") as HTMLFormElement
      ).reset();
      document.getElementById("imagePreview")?.classList.add("hidden");
    }
  });

  const userCheckboxes = document.querySelectorAll(
    ".userCheckbox"
  ) as NodeListOf<HTMLInputElement>;
  const btnEditarProducto = document.getElementById(
    "editarProducto"
  ) as HTMLButtonElement;
  const modalEditar = document.getElementById(
    "modalEditarProductos"
  ) as HTMLElement;
  const btnCancelarEditarProducto = document.getElementById(
    "cancelarEditarProducto"
  ) as HTMLButtonElement;

  userCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener("change", function () {
      if (this.checked) {
        userCheckboxes.forEach((otherCheckbox) => {
          if (otherCheckbox !== this) {
            otherCheckbox.checked = false;
          }
        });
      }
    });
  });

  btnEditarProducto.addEventListener("click", () => {
    const selectedCheckbox = document.querySelector(
      ".userCheckbox:checked"
    ) as HTMLInputElement;

    if (!selectedCheckbox) {
      alert("Por favor, selecciona un producto para actualizar.");
      return;
    }

    const producto: Gafas = {
      id: parseInt(selectedCheckbox.dataset.id || "0"),
      nombre: selectedCheckbox.dataset.nombre || "",
      marca: selectedCheckbox.dataset.marca || "",
      precio: parseFloat(selectedCheckbox.dataset.precio || "0"),
      stock: parseInt(selectedCheckbox.dataset.stock || "0"),
      imagen: selectedCheckbox.dataset.imagen || "",
      tipomontura: selectedCheckbox.dataset.tipomontura || "",
      color: selectedCheckbox.dataset.color || "",
    };

    loadProductDataInModal(producto);
  });

  function loadProductDataInModal(producto: Gafas) {
    if (!modalEditar) return;

    (document.getElementById("productoId") as HTMLInputElement).value =
      producto.id.toString();
    (document.getElementById("editNombre") as HTMLInputElement).value =
      producto.nombre;
    (document.getElementById("editMarca") as HTMLSelectElement).value =
      producto.marca;
    (document.getElementById("editPrecio") as HTMLInputElement).value =
      producto.precio.toString();
    (document.getElementById("editStock") as HTMLInputElement).value =
      producto.stock.toString();
    (document.getElementById("editTipoMontura") as HTMLSelectElement).value =
      producto.tipomontura;
    (document.getElementById("editColor") as HTMLSelectElement).value =
      producto.color;

    const imagenActualInput = document.getElementById(
      "imagenActual"
    ) as HTMLInputElement;
    imagenActualInput.value = producto.imagen;

    const previewImage = document.getElementById(
      "previewImageEdit"
    ) as HTMLImageElement;
    previewImage.src = producto.imagen;
    document.getElementById("imagePreviewEdit")?.classList.remove("hidden"); // Asegurarse de que la previsualización sea visible

    modalEditar.classList.remove("hidden");
  }

  btnCancelarEditarProducto.addEventListener("click", () => {
    modalEditar.classList.add("hidden");
    (document.getElementById("formEditarProducto") as HTMLFormElement).reset();
    (document.getElementById("imagenInputEdit") as HTMLInputElement).value = "";
    (document.getElementById("previewImageEdit") as HTMLImageElement).src = "";
    document.getElementById("imagePreviewEdit")?.classList.add("hidden"); // Ocultar previsualización al cancelar
  });

  window.addEventListener("click", (event) => {
    if (event.target === modalEditar) {
      modalEditar.classList.add("hidden");
      (
        document.getElementById("formEditarProducto") as HTMLFormElement
      ).reset();
      (document.getElementById("imagenInputEdit") as HTMLInputElement).value =
        "";
      (document.getElementById("previewImageEdit") as HTMLImageElement).src =
        "";
      document.getElementById("imagePreviewEdit")?.classList.add("hidden"); // Ocultar previsualización al cerrar
    }
  });

  document
    .getElementById("formEditarProducto")
    ?.addEventListener("submit", async function (e) {
      e.preventDefault();

      const submitButton = document.getElementById(
        "submitEditarProducto"
      ) as HTMLButtonElement;
      if (!submitButton) return;

      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);

      if (!validateProductForm(formData, true)) {
        // 'true' para indicar que es el formulario de edición
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = "Actualizando...";

      try {
        const productoId = (
          document.getElementById("productoId") as HTMLInputElement
        ).value;

        let imagenBase64 = formData.get("imagenActual") as string;
        const imagenInput = document.getElementById(
          "imagenInputEdit"
        ) as HTMLInputElement;

        if (imagenInput.files && imagenInput.files[0]) {
          imagenBase64 = await convertToBase64(imagenInput.files[0]);
        }

        const productoData: Gafas = {
          id: parseInt(productoId),
          nombre: formData.get("nombre") as string,
          marca: formData.get("marca") as string,
          precio: parseFloat(formData.get("precio") as string),
          stock: parseInt(formData.get("stock") as string),
          imagen: imagenBase64,
          tipomontura: formData.get("tipomontura") as string,
          color: formData.get("color") as string,
        };

        const response = await updateProducto(productoData);

        if (response.success) {
          alert("Producto actualizado exitosamente");
          window.location.reload();
        } else {
          throw new Error(response.error || "Error al actualizar el producto");
        }
      } catch (error) {
        console.error("Error:", error);
        alert(
          error instanceof Error
            ? error.message
            : "Ocurrió un error al actualizar el producto"
        );
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Guardar Cambios";
      }
    });

  document
    .getElementById("imagenInputEdit")
    ?.addEventListener("change", function (this: HTMLInputElement) {
      const previewImage = document.getElementById(
        "previewImageEdit"
      ) as HTMLImageElement;
      if (!previewImage) return;

      if (this.files && this.files[0]) {
        const reader = new FileReader();
        reader.onload = (e) => {
          previewImage.src = e.target?.result as string;
          document
            .getElementById("imagePreviewEdit")
            ?.classList.remove("hidden");
        };
        reader.readAsDataURL(this.files[0]);
      } else {
        // Si se borra la selección de imagen, mostrar la imagen actual o ocultar si no hay
        const imagenActual = (
          document.getElementById("imagenActual") as HTMLInputElement
        )?.value;
        if (imagenActual) {
          previewImage.src = imagenActual;
          document
            .getElementById("imagePreviewEdit")
            ?.classList.remove("hidden");
        } else {
          previewImage.src = "";
          document.getElementById("imagePreviewEdit")?.classList.add("hidden");
        }
      }
    });

  document
    .getElementById("eliminarProducto")
    .addEventListener("click", async () => {
      const selectedCheckbox = document.querySelector(
        ".userCheckbox:checked"
      ) as HTMLInputElement;

      if (!selectedCheckbox) {
        alert("Por favor, selecciona un producto para eliminar.");
        return;
      }

      const id = Number(selectedCheckbox.getAttribute("data-id"));

      const confirmDelete = window.confirm(
        "¿Estás seguro de que deseas eliminar este producto?"
      );

      if (!confirmDelete) {
        return;
      }
      try {
        const response = await deleteProducto(id);

        if (response.success) {
          alert("Producto eliminado con éxito.");
          location.reload();
        } else {
          alert("Hubo un error al eliminar el producto: " + response.error);
        }
      } catch (error) {
        console.error("Error al eliminar el producto:", error);
        alert("Hubo un error al intentar eliminar el producto.");
      }
    });
</script>
