---
import LayoutInicio from "../layouts/LayoutInicio.astro";
import Navbar from "../components/UI/navbar.astro";
import NuestrasOpticas from "../components/nuestrasOpticas.astro";
import VentaProductos from "../components/ventaProductos.astro";
import Filtro from "../components/UI/filtro.astro";
import Filtrotelefono from "../components/UI/filtrotelefono.astro";

const params = Astro.url.searchParams;
const view = params.get("view");

let SelectedComponent;
switch (view) {
  case "vista-gafas":
    SelectedComponent = VentaProductos;
    break;
  case "nuestras-clinicas":
    SelectedComponent = NuestrasOpticas;
    break;
  default:
    SelectedComponent = VentaProductos;
}

// Estado inicial de los filtros
const filterState = {
  selectedBrands: [],
  selectedFrameTypes: [],
  selectedColors: [],
};
---

<LayoutInicio title="SoftwareOptico">
  <section class="fixed top-0 w-full z-50">
    <Navbar />
  </section>

  <div class="mt-16">
    <div class="flex flex-row p4">
      {
        view !== "nuestras-clinicas" && (
          <aside class="">
            <Filtro />
          </aside>
        )
      }

      <main>
        <slot />
        <SelectedComponent />
        <Filtrotelefono />
      </main>
    </div>
  </div>
</LayoutInicio>

<script is:inline>
  document.addEventListener("DOMContentLoaded", (event) => {
    // Configuración inicial
    if (!window.location.search.includes("nuestras-clinicas")) {
      const minPriceSpan = document.getElementById("min-price");
      const maxPriceSpan = document.getElementById("max-price");
      const openBtn = document.getElementById("open-filter");
      const modal = document.getElementById("filter-modal");
      const closeBtn = document.getElementById("close-filter");

      if (openBtn && modal && closeBtn) {
        openBtn.addEventListener("click", () => {
          modal.classList.remove("hidden");
        });

        closeBtn.addEventListener("click", () => {
          modal.classList.add("hidden");
        });
      }
      // Estado de los filtros
      let filterState = {
        priceRange: 200,
        selectedBrands: [],
        selectedFrameTypes: [],
        selectedColors: [],
      };
      // Actualizar filtros de checkbox
      function updateFilters(filterType, value) {
        const filterArray =
          filterType === "brand"
            ? filterState.selectedBrands
            : filterType === "frame"
              ? filterState.selectedFrameTypes
              : filterState.selectedColors;

        const index = filterArray.indexOf(value);
        if (index > -1) {
          filterArray.splice(index, 1);
        } else {
          filterArray.push(value);
        }
        applyFilters();
      }

      // Aplicar todos los filtros
      function applyFilters() {
        const eyeglassesGrid = document.getElementById("eyeglasses-grid");
        if (!eyeglassesGrid) return;

        const eyeglasses = Array.from(eyeglassesGrid.children);

        eyeglasses.forEach((glasses) => {
          const price = parseInt(
            glasses
              .querySelector(".bg-\\[\\#24c1ffe5\\]")
              ?.textContent.replace("$", "") || "0"
          );
          const brand =
            glasses
              .querySelector("p:nth-of-type(1)")
              ?.textContent.replace("Marca: ", "") || "";
          const frameType =
            glasses
              .querySelector("p:nth-of-type(2)")
              ?.textContent.replace("Tipo: ", "") || "";
          const color =
            glasses
              .querySelector("p:nth-of-type(3)")
              ?.textContent.replace("Color: ", "") || "";

          const matchesPrice = price <= filterState.priceRange;
          const matchesBrand =
            filterState.selectedBrands.length === 0 ||
            filterState.selectedBrands.includes(brand);
          const matchesFrameType =
            filterState.selectedFrameTypes.length === 0 ||
            filterState.selectedFrameTypes.includes(frameType);
          const matchesColor =
            filterState.selectedColors.length === 0 ||
            filterState.selectedColors.includes(color);

          glasses.style.display =
            matchesPrice && matchesBrand && matchesFrameType && matchesColor
              ? ""
              : "none";
        });
      }

      document
        .querySelectorAll('input[type="checkbox"]')
        .forEach((checkbox) => {
          checkbox.addEventListener("change", (e) => {
            const target = e.target;
            const filterType = target.id.split("-")[0];
            const value = target.value;
            updateFilters(filterType, value);
          });
        });

      // Aplicar filtros iniciales
    }
  });
</script>
